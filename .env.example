# Copy to .env and fill in. Never commit .env and never paste these values into chat or issues.

# --- Chain ---
# Arc testnet RPC. The public endpoint works; a QuickNode endpoint is faster.
ARC_RPC_URL=https://rpc.testnet.arc.io
# Address of the deployed Policy contract. Leave empty to use the local devchain deployment.
POLICY_ADDRESS=

# --- Agent (MCP server) ---
# Private key of the agent's Arc account. It can only propose trades.
AGENT_PRIVATE_KEY=
# Token Grok Bot presents to the MCP server.
MCP_AUTH_TOKEN=
MCP_PORT=8787

# --- Console ---
# Shared secret between the console backend and the MCP server (holdings endpoint).
CONSOLE_SERVICE_TOKEN=
CONSOLE_URL=http://localhost:3000

# --- QuickNode Streams ---
QUICKNODE_API_KEY=
# Security token QuickNode signs webhook deliveries with.
QUICKNODE_STREAM_SECURITY_TOKEN=

# --- x402 signal API ---
SIGNALS_PORT=8788
# Address that receives signal payments.
SIGNALS_SELLER_ADDRESS=
SIGNALS_URL=http://localhost:8788
