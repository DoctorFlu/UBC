{
  "name": "mandate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Guardrailed prediction-market agents: rules on Arc, trading on Gemini, Grok Bot as the agent.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "brand",
    "shared",
    "gemini",
    "planner",
    "agent",
    "signals",
    "devchain",
    "streams",
    "redteam",
    "dashboard",
    "site"
  ],
  "scripts": {
    "lint": "npm run typegen --workspaces --if-present && eslint --concurrency 2 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p deploy",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "plan": "tsx planner/scripts/plan.ts",
    "signals:start": "npm run start -w @mandate/signals",
    "x402:keygen": "npm run x402:keygen -w @mandate/agent",
    "arc:keygen": "npm run arc:keygen -w @mandate/agent --",
    "arc:doctor": "tsx devchain/scripts/arc-doctor.ts",
    "x402:hello": "npm run x402:hello -w @mandate/agent --",
    "x402:status": "npm run x402:status -w @mandate/agent",
    "dev:mcp": "npm run dev:mcp -w @mandate/agent --",
    "start:mcp": "npm run start:mcp -w @mandate/agent --",
    "dev:tunnel": "npm run dev:tunnel -w @mandate/agent --",
    "mcp:token": "npm run mcp:token -w @mandate/agent --",
    "mcp:smoke": "npm run mcp:smoke -w @mandate/agent --",
    "mcp:e2e": "npm run mcp:e2e -w @mandate/agent --",
    "mcp:tools": "npm run mcp:tools -w @mandate/agent --",
    "signal:e2e": "npm run signal:e2e -w @mandate/agent --",
    "dev:chain": "tsx devchain/scripts/chain.ts",
    "dev:stack": "tsx devchain/scripts/stack.ts",
    "dev:executor": "tsx devchain/scripts/executor.ts",
    "dev:settle-proof": "tsx devchain/scripts/settle-proof.ts",
    "gemini:doctor": "tsx gemini/scripts/doctor.ts",
    "gemini:sandbox-orders": "tsx gemini/scripts/sandbox-orders.ts",
    "dev:propose": "tsx devchain/scripts/propose.ts",
    "redteam": "tsx redteam/src/cli.ts",
    "e2e": "npm run e2e -w @mandate/dashboard && npm run e2e -w @mandate/site",
    "screenshots": "npm run screenshots -w @mandate/dashboard",
    "e2e:site": "npm run e2e -w @mandate/site",
    "dev:site": "npm run dev -w @mandate/site",
    "console:admin": "npm run admin -w @mandate/dashboard --"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
