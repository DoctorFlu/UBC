# Mandate host settings. Copy to deploy/.env on the host (deploy/init-env.sh does it), never commit it,
# and keep it readable by its owner only (chmod 600). docker compose reads deploy/.env by itself.
# Every value below is empty on purpose: fill them on the host. docs/configuration.md says more about each.
# Values with a "$" in them must be in single quotes, or docker compose reads the "$" as a variable.

# ---------------------------------------------------------------------------------------------- chain
# The compose files to combine, separated by ":". Keep exactly one line: compose.yml, then the chain, then
# any of the optional files.
#   chain     compose.demo.yml     self-contained demo chain (anvil, deploy-once, simulated executor)
#             compose.arc.yml      the Policy contract on Arc testnet (needs the Arc variables below)
#   optional  compose.gateway.yml  behind a proxy that ends TLS (InstaBox): plain HTTP on MANDATE_APP_PORT
#             compose.site.yml     the landing page from site/out as a second origin (build it first)
# For example compose.yml:compose.demo.yml:compose.gateway.yml on InstaBox.
COMPOSE_FILE=compose.yml:compose.demo.yml

# Demo chain only: which Policy contract to deploy, reference (default) or production.
DEVCHAIN_CONTRACT=
# Demo chain only: seconds between anvil's saves of the chain (it also saves on shutdown). Default 60.
ANVIL_STATE_INTERVAL=
# Demo chain only: how often the simulated executor asks for new approvals, in milliseconds. Default 1000.
SIM_EXECUTOR_POLL_MS=
# Demo chain only: how often the executor checks filled positions on expired markets for Gemini's published
# outcome, in milliseconds (at least 1000). Default 60000.
EXECUTOR_SETTLE_MS=

# Arc testnet only: the deployed Policy contract (0x address). Required for compose.arc.yml.
POLICY_ADDRESS=
# Arc testnet only: the block the Policy contract was deployed in. Required for compose.arc.yml.
POLICY_DEPLOY_BLOCK=
# Arc testnet only: the agent account's private key; it can only propose trades. Required for compose.arc.yml.
AGENT_PRIVATE_KEY=
# Arc testnet only: an RPC endpoint for the servers (the browser always uses Arc's public RPC). Default https://rpc.testnet.arc.io.
ARC_RPC_URL=

# --------------------------------------------------------------------------------------- public address
# The app's public name: for example 203-0-113-10.sslip.io (Caddy gets its certificate for it), or behind
# a proxy the name it serves, such as 8080-<machine id>.instabox.tech. Required.
MANDATE_HOST=
# Only when the public address is not https://<MANDATE_HOST> (a non-standard port): the console's public URL.
MANDATE_PUBLIC_URL=
# Host ports Caddy publishes for HTTP and HTTPS. Default 80 and 443; Let's Encrypt needs those two.
MANDATE_HTTP_PORT=
MANDATE_HTTPS_PORT=
# Gateway mode and the site: the host ports for the app and the landing page. Default 8080 and 8081.
MANDATE_APP_PORT=
MANDATE_SITE_PORT=
# Gateway mode and the site: the interface those ports listen on. Default 127.0.0.1, where InstaBox's proxy connects.
MANDATE_BIND_ADDRESS=
# The site only: its address in Caddy. Default http://:8081 (gateway mode); a public name such as example.com for HTTPS.
MANDATE_SITE_ADDRESS=
# The site only: the built site's folder, relative to deploy/. Default ../site/out.
MANDATE_SITE_DIR=
# The site only, read by deploy/build-site.sh and baked into the pages (all public). The app's URL defaults to
# MANDATE_PUBLIC_URL, else https://<MANDATE_HOST>; the site's own URL to https://<MANDATE_SITE_ADDRESS> when that
# is a name, and must be set in gateway mode (on InstaBox https://8081-<machine id>.instabox.tech); the
# scorecard's agent to the demo chain's; no source link.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SCORECARD_AGENT=
NEXT_PUBLIC_REPO_URL=

# ------------------------------------------------------------------------------------- owner's login
# User name for the console's owner login (HTTP basic auth in Caddy). Default owner.
CONSOLE_USER=
# Hash of the owner's console password. Set it with deploy/set-console-password.sh, never by hand.
# While it is empty, every owner route refuses everyone (the scorecard, /mcp and the webhook still work).
CONSOLE_PASSWORD_HASH=

# ---------------------------------------------------------------------------------- MCP server and console
# Token Grok Bot's connector sends as "Authorization: Bearer <token>", at least 32 characters. deploy/init-env.sh creates it. Required.
MCP_AUTH_TOKEN=
# Shared secret between the console and the MCP server on the private network. deploy/init-env.sh creates it. Required.
CONSOLE_SERVICE_TOKEN=
# MCP server log level: debug, info (default), warn or error.
MCP_LOG_LEVEL=
# true to include each tool's output schema in tools/list. Default false.
MCP_ADVERTISE_OUTPUT_SCHEMAS=

# ------------------------------------------------------------------------------- QuickNode Stream webhook
# Token QuickNode signs webhook deliveries with; while empty the console refuses every delivery.
QUICKNODE_STREAM_SECURITY_TOKEN=
# The console's live source: rpc (default, polls the chain) or stream (the webhook, with a slow poll for gaps).
CONSOLE_EVENT_SOURCE=
# How often the console polls the chain, in milliseconds. Default 1000 (the hosted demo chain and Arc).
CONSOLE_POLL_INTERVAL_MS=

# --------------------------------------------------------------------------------- x402 signal payments
# Address that receives signal payments (public; from npm run x402:keygen). The signal API needs it to start. Required.
X402_SELLER_ADDRESS=
# Key of the wallet that pays for signals. Empty: the agent plans without buying signals.
X402_BUYER_PRIVATE_KEY=
# Circle Gateway API for x402 verify and settle. Default Circle's testnet Gateway.
X402_FACILITATOR_URL=
# Price of one hedge signal in USDC, from 0.000001 to 0.009999. Default 0.001.
SIGNALS_HEDGE_PRICE_USD=
# Comma-separated assets the signal API sells signals for. Default every asset the Gemini client knows.
SIGNALS_ASSETS=
# Edge in cents, either way, below which protection counts as fairly priced, 1 to 50. Default 2.
SIGNALS_FAIR_BAND_CENTS=
# Hours of candles behind the realised volatility, 24 to 1000. Default 168.
SIGNALS_VOL_WINDOW_HOURS=
# Most the agent spends on signals per UTC day, in USDC. Default 0.02.
SIGNAL_DAILY_BUDGET_USDC=
# Most the agent pays for one signal, in USDC. Default 0.005.
SIGNAL_MAX_PRICE_USDC=
