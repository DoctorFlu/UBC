# The app's routes, imported into the app's site block by both Caddyfiles: Caddyfile (automatic HTTPS on a
# public name) and Caddyfile.gateway (plain HTTP behind a proxy that ends TLS). This file is the one place
# the route split is decided.
#
# Anything not listed as public needs a signed-in member, so a route added to the console later is private
# until someone decides otherwise here.
#
#   public, with its own check   /mcp                      bearer token, which the console resolves to one
#                                                          agent (docs/accounts.md)
#                                /api/webhooks/quicknode   HMAC signature, checked by the console
#                                /api/auth/*               passkey sign-up, claim, recovery, sign-in and
#                                                          sign-out: the way to a session, rate limited by
#                                                          the console
#   public, nothing private      /sign-in, /sign-up,       the account pages
#                                /claim, /recover
#                                /agent/*                  the agent's public scorecard
#                                /_next/static/*           the scripts, styles and fonts every page loads
#                                /api/health, /mcp/health  liveness, no data
#                                /favicon.ico, /icon.svg,  the browser's tab and home-screen icons
#                                /apple-icon.png
#   internal only (404 here)     /api/agent/*              the console's agent API: the MCP server calls it
#                                                          on the private network, nobody else needs it
#                                /api/executor/*           the console's executor API: the executor records
#                                                          settlements on the private network (signed, but
#                                                          nobody else needs to reach it)
#   member (a session)           everything else           the console's pages, /api/console/* (snapshot,
#                                                          live events, writes, agents and tokens), and on
#                                                          the demo chain /rpc. The console checks the
#                                                          session as well; asking it here first keeps a
#                                                          route nobody listed from ever being public.
#
# Rate limits live in the console and the MCP server (the stock Caddy image has no limiter). Both key them
# on the client address Caddy appends to X-Forwarded-For (CONSOLE_TRUST_PROXY and MCP_TRUST_PROXY).
#
# The signal API is not routed at all: only the MCP server calls it, on the private network.

log {
	output stdout
	format json
}

request_body {
	max_size 4MB
}

header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	-Server
}

handle /mcp {
	reverse_proxy mcp:8787
}

handle /mcp/health {
	rewrite * /health
	reverse_proxy mcp:8787
}

handle /api/webhooks/quicknode {
	reverse_proxy console:3000
}

handle /api/agent/* {
	respond 404
}

handle /api/executor/* {
	respond 404
}

# A page on another site must not be able to act with a member's session. Opening a console link from
# elsewhere (the pairing link in Grok Bot's chat) is a navigation, and is allowed. The console also checks
# the Origin of every write.
@crossSite {
	header Sec-Fetch-Site cross-site
	header Sec-Fetch-Site same-site
	not {
		method GET HEAD
		header Sec-Fetch-Mode navigate
	}
}

@public path /sign-in /sign-up /claim /recover /api/auth/* /agent/* /_next/static/* /api/health /favicon.ico /icon.svg /apple-icon.png
handle @public {
	respond @crossSite "Cross-site request refused" 403
	reverse_proxy console:3000
}

handle {
	route {
		respond @crossSite "Cross-site request refused" 403

		# The console says whether the session cookie belongs to a live session: 204 lets the request
		# through, a page opened without one is sent to /sign-in, and anything else gets a 401.
		forward_auth console:3000 {
			uri /api/auth/forward
		}

		# Member routes that exist only in some setups (the demo chain's /rpc), see compose.demo.yml.
		import /etc/caddy/owner/*.caddy

		reverse_proxy console:3000
	}
}
