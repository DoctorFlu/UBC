# Mandate on a public name, with automatic HTTPS: a Let's Encrypt certificate for a public name, or a
# certificate from Caddy's own authority for localhost. The routes are in caddy/app-routes.caddy.
#
# Behind a proxy that ends TLS itself (InstaBox), compose.gateway.yml uses Caddyfile.gateway instead.
{
	# The compose file publishes TCP 80 and 443 only, so HTTP/3 (UDP) is off.
	servers {
		protocols h1 h2
	}
}

{$MANDATE_HOST} {
	import /etc/caddy/app-routes.caddy
}

# The landing page, when compose.site.yml is in COMPOSE_FILE (MANDATE_SITE_ADDRESS names its host).
import /etc/caddy/sites/*.caddy
