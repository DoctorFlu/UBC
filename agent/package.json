{
  "name": "@mandate/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that Grok Bot connects to.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "x402:keygen": "tsx scripts/x402-keygen.ts",
    "x402:hello": "tsx scripts/x402-hello.ts",
    "x402:status": "tsx scripts/x402-status.ts",
    "dev:mcp": "tsx watch src/main.ts",
    "start:mcp": "tsx src/main.ts",
    "dev:tunnel": "tsx scripts/tunnel.ts",
    "mcp:token": "tsx scripts/mcp-token.ts",
    "mcp:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^4.0.0",
    "@hono/node-server": "^2.1.8",
    "@mandate/gemini": "*",
    "@mandate/planner": "*",
    "@mandate/shared": "*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@x402/core": "^2.31.0",
    "@x402/evm": "^2.31.0",
    "hono": "^4.13.18",
    "viem": "^2.57.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mandate/devchain": "*",
    "@mandate/signals": "*",
    "@modelcontextprotocol/client": "^2.4.0"
  }
